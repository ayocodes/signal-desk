# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server and agent only, never in browser code

# LLM
LLM_PROVIDER=gemini                 # gemini | groq
GEMINI_API_KEY=
GEMINI_MODEL=                       # a free-tier Flash model id from AI Studio
GROQ_API_KEY=                       # optional fallback, free, no card
GROQ_MODEL=

# Email (Resend sandbox, test inboxes only)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=              # added in phase 5

# Demo accounts created by the seed script
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_REP_EMAIL=rep@example.com
DEMO_REP_PASSWORD=

# Agent
AGENT_USER_AGENT="SignalDesk-demo/0.1 (portfolio project; contact: your-email-here)"
DRAFTS_PER_RUN=5
DISCOVERY_PROBES_PER_RUN=40

# Optional: "Run agent now" button in Ops
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=owner/repo
